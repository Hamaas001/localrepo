// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// User accounts for admin/staff authentication
model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  // Relations
  createdWarranties Warranty[] @relation("UserCreatedWarranties")
  createdNotes      Note[]     @relation("UserCreatedNotes")
}

/// Customer warranty registrations
model Warranty {
  id               String   @id @default(cuid())
  customerName     String
  customerEmail    String
  customerPhone    String
  carMake          String
  carModel         String
  carRegistration  String
  mileage          Int
  purchaseDate     DateTime
  createdAt        DateTime @default(now())

  // Optional linkage to the admin who created the record
  createdById String?
  createdBy   User?    @relation("UserCreatedWarranties", fields: [createdById], references: [id])

  notes Note[]

  @@index([customerEmail])
  @@index([carRegistration])
  @@index([createdAt])
}

/// Timestamped notes on a warranty record
model Note {
  id         String   @id @default(cuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  authorName String
  content    String
  createdAt  DateTime @default(now())

  // Optional linkage to the admin user account
  createdById String?
  createdBy   User?    @relation("UserCreatedNotes", fields: [createdById], references: [id])

  @@index([warrantyId])
  @@index([createdAt])
}

enum Role {
  ADMIN
}
